e:12px&quot; color=&quot;#5F6B7A&quot;&gt;CI/CD pipeline: deploy.yml&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5F6B7A&quot;&gt;lint + validate + deploy on push&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#8A95A3;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="1205" width="240" height="90" as="geometry"/></mxCell><mxCell id="c_iam" value="&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#232F3E&quot;&gt;&lt;b&gt;IAM role (OIDC)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F6B7A&quot;&gt;trust: this repository only&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F6B7A&quot;&gt;ARN in secret AWS_ROLE_TO_ASSUME&lt;/font&gt;" style="shape=image;html=1;aspect=fixed;image=data:image/svg+xml,;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;spacingTop=2;spacingBottom=2;fontColor=#232F3E;" vertex="1" parent="c_cloud"><mxGeometry x="118" y="1118" width="64" height="64" as="geometry"/></mxCell><mxCell id="c_cfn" value="&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#232F3E&quot;&gt;&lt;b&gt;AWS CloudFormation&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F6B7A&quot;&gt;stack: wordpress-stack&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F6B7A&quot;&gt;wordpress-infra.yaml&lt;/font&gt;" style="shape=image;html=1;aspect=fixed;image=data:image/svg+xml,;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;spacingTop=2;spacingBottom=2;fontColor=#232F3E;" vertex="1" parent="c_cloud"><mxGeometry x="538" y="1118" width="64" height="64" as="geometry"/></mxCell><mxCell id="c_legend" value="" style="rounded=1;arcSize=3;html=1;fillColor=#FFFFFF;strokeColor=#C7CED6;strokeWidth=1.5;container=1;collapsible=0;" vertex="1" parent="c_region"><mxGeometry x="1025" y="55" width="440" height="285" as="geometry"/></mxCell><mxCell id="c_legend_title" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#232F3E&quot;&gt;&lt;b&gt;Request flow&lt;/b&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;" vertex="1" parent="c_legend"><mxGeometry x="15" y="10" width="300" height="20" as="geometry"/></mxCell><mxCell id="c_lg_b1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;spacing=0;" vertex="1" parent="c_legend"><mxGeometry x="15" y="37" width="24" height="24" as="geometry"/></mxCell><mxCell id="c_lg_t1" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#232F3E&quot;&gt;Visitor opens the ALB DNS name (the WordPressURL stack&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#232F3E&quot;&gt;output) in a browser over HTTP&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;" vertex="1" parent="c_legend"><mxGeometry x="47" y="41" width="385" height="36" as="geometry"/></mxCell><mxCell id="c_lg_b2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;spacing=0;" vertex="1" parent="c_legend"><mxGeometry x="15" y="75" width="24" height="24" as="geometry"/></mxCell><mxCell id="c_lg_t2" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#232F3E&quot;&gt;Internet gateway passes the request to the ALB;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#232F3E&quot;&gt;listener HTTP 80 forwards to the target group&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;" vertex="1" parent="c_legend"><mxGeometry x="47" y="79" width="385" height="36" as="geometry"/></mxCell><mxCell id="c_lg_b3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;spacing=0;" vertex="1" parent="c_legend"><mxGeometry x="15" y="113" width="24" height="24" as="geometry"/></mxCell><mxCell id="c_lg_t3" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#232F3E&quot;&gt;ALB forwards to the WordPress EC2 instances&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#232F3E&quot;&gt;(security group accepts port 80 only from the ALB)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;" vertex="1" parent="c_legend"><mxGeometry x="47" y="117" width="385" height="36" as="geometry"/></mxCell><mxCell id="c_lg_b4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;spacing=0;" vertex="1" parent="c_legend"><mxGeometry x="15" y="151" width="24" height="24" as="geometry"/></mxCell><mxCell id="c_lg_t4" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#232F3E&quot;&gt;EC2 connects to RDS MySQL on port 3306&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#232F3E&quot;&gt;(security group accepts only the web servers)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;" vertex="1" parent="c_legend"><mxGeometry x="47" y="155" width="385" height="36" as="geometry"/></mxCell><mxCell id="c_legend_note" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B7A&quot;&gt;&lt;i&gt;ASG min / max / desired are parameters (template defaults 1 / 1 / 1).&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B7A&quot;&gt;&lt;i&gt;Faded instance and dashed arrows: only when desired capacity ≥ 2.&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B7A&quot;&gt;&lt;i&gt;HTTP only: this template has no TLS listener or certificate.&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B7A&quot;&gt;&lt;i&gt;RDS placement in its subnet group is chosen by AWS (shown in AZ 1).&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B7A&quot;&gt;&lt;i&gt;Instances use public subnets, so no NAT gateway is needed.&lt;/i&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;" vertex="1" parent="c_legend"><mxGeometry x="15" y="195" width="425" height="77" as="geometry"/></mxCell><mxCell id="c_cap_cw" value="&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F6B7A&quot;&gt;metrics&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;" vertex="1" parent="c_region"><mxGeometry x="1002" y="403" width="110" height="18" as="geometry"/></mxCell><mxCell id="c_cap_oidc" value="&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F6B7A&quot;&gt;OIDC · no keys&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="342" y="1226" width="110" height="18" as="geometry"/></mxCell><mxCell id="c_cap_assume" value="&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F6B7A&quot;&gt;assumes role&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacing