ngTop=0;" vertex="1" parent="c_vpc"><mxGeometry x="65" y="295" width="800" height="185" as="geometry"/></mxCell><mxCell id="c_asg_ic" value="" style="shape=image;html=1;aspect=fixed;image=data:image/svg+xml,;pointerEvents=0;" vertex="1" parent="c_asg"><mxGeometry x="0" y="0" width="32" height="32" as="geometry"/></mxCell><mxCell id="c_igw" value="" style="shape=image;html=1;aspect=fixed;image=data:image/svg+xml,;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;spacingTop=2;spacingBottom=2;fontColor=#232F3E;" vertex="1" parent="c_vpc"><mxGeometry x="-24" y="76" width="48" height="48" as="geometry"/></mxCell><mxCell id="c_igw_lbl" value="&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#232F3E&quot;&gt;&lt;b&gt;Internet gateway&lt;/b&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;" vertex="1" parent="c_vpc"><mxGeometry x="18" y="134" width="130" height="20" as="geometry"/></mxCell><mxCell id="c_alb" value="&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#232F3E&quot;&gt;&lt;b&gt;Application Load Balancer&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F6B7A&quot;&gt;HTTP 80 → target group&lt;/font&gt;" style="shape=image;html=1;aspect=fixed;image=data:image/svg+xml,;labelPosition=center;align=center;verticalLabelPosition=top;verticalAlign=bottom;spacingTop=2;spacingBottom=2;fontColor=#232F3E;" vertex="1" parent="c_vpc"><mxGeometry x="441" y="76" width="48" height="48" as="geometry"/></mxCell><mxCell id="c_ec2a" value="&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#232F3E&quot;&gt;&lt;b&gt;WordPress EC2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F6B7A&quot;&gt;t3.micro&lt;/font&gt;" style="shape=image;html=1;aspect=fixed;image=data:image/svg+xml,;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;spacingTop=2;spacingBottom=2;fontColor=#232F3E;" vertex="1" parent="c_asg"><mxGeometry x="145" y="38" width="64" height="64" as="geometry"/></mxCell><mxCell id="c_ec2b" value="&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#5F6B7A&quot;&gt;&lt;b&gt;WordPress EC2 (optional)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F6B7A&quot;&gt;&lt;i&gt;runs when desired capacity ≥ 2&lt;/i&gt;&lt;/font&gt;" style="shape=image;html=1;aspect=fixed;image=data:image/svg+xml,;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;spacingTop=2;spacingBottom=2;fontColor=#232F3E;opacity=40;textOpacity=100;" vertex="1" parent="c_asg"><mxGeometry x="590" y="38" width="64" height="64" as="geometry"/></mxCell><mxCell id="c_rds" value="&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#232F3E&quot;&gt;&lt;b&gt;Amazon RDS MySQL&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F6B7A&quot;&gt;8.4.9 · db.t3.micro · Single-AZ&lt;/font&gt;" style="shape=image;html=1;aspect=fixed;image=data:image/svg+xml,;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;spacingTop=2;spacingBottom=2;fontColor=#232F3E;" vertex="1" parent="c_pr1"><mxGeometry x="160" y="63" width="64" height="64" as="geometry"/></mxCell><mxCell id="c_pr2_note" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#5F6B7A&quot;&gt;&lt;i&gt;DB subnet group member&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5F6B7A&quot;&gt;&lt;i&gt;no standby instance (Multi-AZ off)&lt;/i&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;" vertex="1" parent="c_pr2"><mxGeometry x="0" y="100" width="385" height="36" as="geometry"/></mxCell><mxCell id="c_cw" value="&lt;font style=&quot;font-size:12.5px&quot; color=&quot;#232F3E&quot;&gt;&l